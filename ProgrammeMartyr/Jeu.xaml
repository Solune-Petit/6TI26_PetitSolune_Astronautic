<Window x:Class="ProgrammeMartyr.Jeu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProgrammeMartyr"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="700"
        Width="900"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen">

    <!--// Background Grid //-->

    <Grid x:Name="GrdJeu"
          Background="DarkGray">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!--// Main Menu //-->

        <Menu   Background="Transparent"
                Grid.Row="0"
                Grid.Column="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">


            <Menu.ItemsPanel>

                <ItemsPanelTemplate>

                    <VirtualizingStackPanel Orientation="Vertical" />

                </ItemsPanelTemplate>

            </Menu.ItemsPanel>

            <!--// Main Menu - Menu //-->

            <MenuItem   Header="☰"
                        FontSize="25">

                <!--// Menu Submenu - Home//-->

                <MenuItem Header="🏠︎"
                          Click="MenuBtn_Click"/>

                <!--// menu submenu - Settings //-->

                <MenuItem Header="Settings">

                    <MenuItem.Icon>

                        <Image Source="Assets/img_setting.jpg"
                                   Stretch="None" />

                    </MenuItem.Icon>

                    <MenuItem Header="Color Mode"
                              Click="ColorModeBtn_Click"/>

                    <MenuItem   Header="Profile"
                                Click="ProfileBtn_Click"/>

                </MenuItem>

                <!--// Settings Submenu - Exit //-->

                <MenuItem Header="Exit"
                                Click="CloseBtn_Click"/>

            </MenuItem>


        </Menu>

        
    </Grid>

</Window>
