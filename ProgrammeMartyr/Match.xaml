<UserControl x:Class="ProgrammeMartyr.Match"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProgrammeMartyr"
             mc:Ignorable="d" 
             d:DesignHeight="860" d:DesignWidth="1160">
    <Grid x:Name="grdMatch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!--<StackPanel x:Name="stckPerso1" Grid.Row="0" Grid.Column="0"/>
        <StackPanel x:Name="stckPerso2" Grid.Row="1" Grid.Column="1"/>
        <StackPanel x:Name="stckPerso3" Grid.Row="2" Grid.Column="0"/>
        <StackPanel x:Name="stckPerso4" Grid.Row="3" Grid.Column="1"/>
        <StackPanel x:Name="stckPerso5" Grid.Row="4" Grid.Column="0"/>

        <StackPanel x:Name="stckEnemi1" Grid.Row="0" Grid.Column="4"/>
        <StackPanel x:Name="stckEnemi2" Grid.Row="1" Grid.Column="3"/>
        <StackPanel x:Name="stckEnemi3" Grid.Row="2" Grid.Column="4"/>
        <StackPanel x:Name="stckEnemi4" Grid.Row="3" Grid.Column="3"/>
        <StackPanel x:Name="stckEnemi5" Grid.Row="4" Grid.Column="4"/>-->

        <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Stroke="Black" StrokeThickness="2" Grid.ColumnSpan="6" Grid.Row="5" VerticalAlignment="Top"/>

        <!--bouttons des attaques-->
        <!--faire un bouton en forme d'élipse-->

        <Button x:Name="BtnAttaque1" Grid.Column="2" Grid.Row="5" Width="100" Height="100" Padding="0" Background="Transparent" BorderThickness="0">
            <Ellipse Fill="LightCoral"  Height="100" Width="100"/>
        </Button>

        <Button x:Name="BtnAttaque2" Grid.Column="3" Grid.Row="5" Width="100" Height="100" Padding="0" Background="Transparent" BorderThickness="0">
            <Ellipse Fill="LightCoral"  Height="100" Width="100"/>
        </Button>

        <Button x:Name="BtnAttaque3" Grid.Column="4" Grid.Row="5" Width="100" Height="100" Padding="0" Background="Transparent" BorderThickness="0">
            <Ellipse Fill="LightCoral"  Height="100" Width="100"/>
        </Button>

        <!--affichage des modificateurs de stats-->
        <StackPanel x:Name="stkModifiers" Grid.Row="5" Grid.Column="0">
            
        </StackPanel>
    </Grid>
</UserControl>
