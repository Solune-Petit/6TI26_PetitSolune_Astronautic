<UserControl x:Class="ProgrammeMartyr.Match"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProgrammeMartyr"
             mc:Ignorable="d" 
             d:DesignHeight="860" d:DesignWidth="1160">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <Image x:Name="imgPerso1" Grid.Row="0" Grid.Column="0"/>
        <Image x:Name="imgPerso2" Grid.Row="1" Grid.Column="1"/>
        <Image x:Name="imgPerso3" Grid.Row="2" Grid.Column="0"/>
        <Image x:Name="imgPerso4" Grid.Row="3" Grid.Column="1"/>
        <Image x:Name="imgPerso5" Grid.Row="4" Grid.Column="0"/>
        
        <Image x:Name="imgEnemi1" Grid.Row="0" Grid.Column="4"/>
        <Image x:Name="imgEnemi2" Grid.Row="1" Grid.Column="3"/>
        <Image x:Name="imgEnemi3" Grid.Row="2" Grid.Column="4"/>
        <Image x:Name="imgEnemi4" Grid.Row="3" Grid.Column="3"/>
        <Image x:Name="imgEnemi5" Grid.Row="4" Grid.Column="4"/>

        <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Stroke="Black" StrokeThickness="2" Grid.ColumnSpan="6" Grid.Row="5" VerticalAlignment="Top"/>

        <!--bouttons des attaques-->
        <Ellipse x:Name="ElpsAttaque3" Grid.Row="5" Grid.Column="4" Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
                <ImageBrush x:Name="imgAttaque3"/>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse x:Name="ElpsAttaque2" Grid.Row="5" Grid.Column="3" Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
                <ImageBrush x:Name="imgAttaque2"/>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse x:Name="ElpsAttaque1" Grid.Row="5" Grid.Column="2" Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
                <ImageBrush x:Name="imgAttaque1"/>
            </Ellipse.Fill>
        </Ellipse>

        <!--affichage des modificateurs de stats-->
        <StackPanel x:Name="stkModifiers" Grid.Row="5" Grid.Column="0">
            
        </StackPanel>
    </Grid>
</UserControl>
