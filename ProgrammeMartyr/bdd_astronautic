DROP TABLE IF EXISTS Personnage ;
CREATE TABLE Personnage (Id INT AUTO_INCREMENT NOT NULL,
Nom VARCHAR(25),
Img VARCHAR(25),
Type VARCHAR(25),
Rarete INT(5),
PvMax INT(2500),
LvlMax INT(50),
PRIMARY KEY (Id)) ENGINE=InnoDB;

DROP TABLE IF EXISTS Attaque ;
CREATE TABLE Attaque (Id INT AUTO_INCREMENT NOT NULL,
Puissance INT(50),
Role INT(3),
PRIMARY KEY (Id)) ENGINE=InnoDB;

DROP TABLE IF EXISTS User ;
CREATE TABLE User (Id INT AUTO_INCREMENT NOT NULL,
Name VARCHAR(16),
Password VARCHAR(30),
Mail VARCHAR(255),
PRIMARY KEY (Id)) ENGINE=InnoDB;

DROP TABLE IF EXISTS UserItem ;
CREATE TABLE UserItem (Item INT AUTO_INCREMENT NOT NULL,
Money BIGINT,
Crystal BIGINT,
UpgradeAbility BIGINT,
PRIMARY KEY (Item)) ENGINE=InnoDB;

DROP TABLE IF EXISTS Modifyer ;
CREATE TABLE Modifyer (Id INT AUTO_INCREMENT NOT NULL,
Nom VARCHAR(25),
Description VARCHAR(255),
Duree INT(3),
PRIMARY KEY (Id)) ENGINE=InnoDB;

